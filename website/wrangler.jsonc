{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remarc",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "LAUNCH_AT": "2026-08-11T07:00:00Z"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/", "/_launch", "/_launch/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "WAITLIST_DB",
      "database_name": "remarc-launch-waitlist",
      "database_id": "e6fba528-b87c-480c-bcfd-ec4780983e1d",
      "migrations_dir": "./migrations"
    }
  ],
  "services": [
    {
      "binding": "TURNSTILE_VERIFY",
      "service": "turnstile-siteverify-remarc",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "NOTIFY_IP_RATE_LIMITER",
      "namespace_id": "81926",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "NOTIFY_GLOBAL_RATE_LIMITER",
      "namespace_id": "81927",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
